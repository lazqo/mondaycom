# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/getsecure
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
APP_TIMEZONE=Pacific/Auckland

# Used by `pnpm db:seed` to create the first admin user (only if no users exist).
SEED_ADMIN_EMAIL=admin@getsecure.co.nz
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin

# --- Email ingestion & AI (v0.2) ---
# Encrypts mailbox passwords at rest; defaults to a key derived from AUTH_SECRET.
# ENCRYPTION_KEY=

# Lead classifier: rules (built-in offline, the production default) | auto | anthropic.
# Production runs `rules`: no external AI service, no API key, no per-email cost.
AI_PROVIDER=rules
# Only needed if you deliberately switch to Anthropic:
# AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# Leads are auto-created at or above this confidence; below it they go to Needs review.
AI_LEAD_CONFIDENCE_THRESHOLD=0.75

# Run the IMAP watcher inside the web process (single-service hosting). Otherwise run `pnpm worker`.
INGEST_IN_PROCESS=true
INGEST_POLL_SECONDS=120

# --- Operations (v0.4) ---
# Lets an uptime monitor read detailed /api/health with "Authorization: Bearer <token>".
# HEALTH_TOKEN=
