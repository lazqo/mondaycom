# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/getsecure
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
APP_TIMEZONE=Pacific/Auckland

# Used by `pnpm db:seed` to create the first admin user (only if no users exist).
SEED_ADMIN_EMAIL=admin@getsecure.co.nz
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin

# --- Email ingestion & AI (v0.2) ---
# Encrypts mailbox passwords at rest; defaults to a key derived from AUTH_SECRET.
# ENCRYPTION_KEY=

# Lead classifier: rules (built-in offline, the production default) | auto | anthropic.
# Production runs `rules`: no external AI service, no API key, no per-email cost.
AI_PROVIDER=rules
# Only needed if you deliberately switch to Anthropic:
# AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# Jev: a Claude classifier run beside the Inspector's rules in shadow mode (never drives anything).
# Off unless JEV_SHADOW=on AND ANTHROPIC_API_KEY is set; it sends email/transcript text to Anthropic.
# JEV_SHADOW=off
# JEV_MODEL=claude-opus-5-5
# Leads are auto-created at or above this confidence; below it they go to Needs review.
AI_LEAD_CONFIDENCE_THRESHOLD=0.75

# Run the IMAP watcher inside the web process (single-service hosting). Otherwise run `pnpm worker`.
INGEST_IN_PROCESS=true
INGEST_POLL_SECONDS=120

# --- Operations (v0.4) ---
# Lets an uptime monitor read detailed /api/health with "Authorization: Bearer <token>".
# HEALTH_TOKEN=

# Hermes, the Inspector (docs/DEPLOYMENT_HANDOFF.md section 17). Unset = not connected: new emails
# and conversations wait in the Inspector for Chris.
# HERMES_API_URL=http://host.docker.internal:8642/p/inspector   # the restricted inspector profile (docs/DEPLOYMENT_HANDOFF.md §17)
# HERMES_API_KEY=
# HERMES_MCP_TOKEN=
# Hermes's separate research profile (web + supplier tools, no customer email). Unset = research off.
# HERMES_RESEARCH_API_URL=http://host.docker.internal:8642/p/research
# HERMES_RESEARCH_API_KEY=
# HERMES_RESEARCH_MCP_TOKEN=
