# Copy to .env in the repository root ON THE SERVER and fill in. Never commit the real file.
#   cp deploy/env.example .env && nano .env

# The domain pointing at this VPS. Caddy gets an HTTPS certificate for it automatically.
DOMAIN=hermes.aucklandsecuritysystems.co.nz
APP_URL=https://hermes.aucklandsecuritysystems.co.nz

# This one goes inside a postgres:// URL, so it must not contain / : @ or ?.
# Generate with:  openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate each of these once, on the server:  openssl rand -base64 32
AUTH_SECRET=
ENCRYPTION_KEY=

# Generate with: openssl rand -hex 16   (lets an uptime monitor read detailed health)
HEALTH_TOKEN=

APP_TIMEZONE=Pacific/Auckland

# How often to re-check the mailbox as a backstop, in seconds. New mail normally arrives instantly
# over IMAP IDLE, so this only catches what IDLE missed. Raise it to be gentler on the mail server.
INGEST_POLL_SECONDS=300

# Addresses that only ever send website enquiry forms. Their mail is parsed field by field and
# always becomes a lead, bypassing the junk filter that would otherwise drop a noreply@ sender.
LEAD_SENDER_ADDRESSES=noreply@updates.getsecure.co.nz

# Built-in offline classifier. No Anthropic account, no API key, no per-email cost.
AI_PROVIDER=rules
AI_LEAD_CONFIDENCE_THRESHOLD=0.75
