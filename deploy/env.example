# Copy to .env in the repository root ON THE SERVER and fill in. Never commit the real file.
#   cp deploy/env.example .env && nano .env

# The domain pointing at this VPS. Caddy gets an HTTPS certificate for it automatically.
DOMAIN=hermes.aucklandsecuritysystems.co.nz
APP_URL=https://hermes.aucklandsecuritysystems.co.nz

# Generate each of these once, on the server:  openssl rand -base64 32
POSTGRES_PASSWORD=
AUTH_SECRET=
ENCRYPTION_KEY=

# Generate with: openssl rand -hex 16   (lets an uptime monitor read detailed health)
HEALTH_TOKEN=

APP_TIMEZONE=Pacific/Auckland

# Built-in offline classifier. No Anthropic account, no API key, no per-email cost.
AI_PROVIDER=rules
AI_LEAD_CONFIDENCE_THRESHOLD=0.75
